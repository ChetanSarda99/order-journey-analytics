/// Event log: one row per order per milestone (Order Created, Picked, Invoiced, Delivered). Source: wwi_analytics.wwi.vw_order_event via DirectQuery.
table 'wwi vw_order_event'
	lineageTag: f54202dc-aacc-4aec-bcbd-07e51c978189

	/// Total event rows in the event log. Use for Journey Explorer page.
	measure 'Event Count' = COUNTROWS('wwi vw_order_event')

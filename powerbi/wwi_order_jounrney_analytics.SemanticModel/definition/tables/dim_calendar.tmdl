		sourceColumn: [fiscal_year]

		annotation SummarizationSetBy = Automatic

	column fiscal_period
		formatString: 0
		lineageTag: 78cbbd57-3670-43f3-9982-75d0a2d864e4
		summarizeBy: none
		isNameInferred
		sourceColumn: [fiscal_period]

		annotation SummarizationSetBy = Automatic

	column fiscal_quarter
		lineageTag: db9346d7-76e6-4b2e-94c1-a58bfe03813b
		summarizeBy: none
		isNameInferred
		sourceColumn: [fiscal_quarter]

		annotation SummarizationSetBy = Automatic

	partition dim_calendar = calculated
		mode: import
		source = ```
				
				VAR MinDT =
				    MINX ( ALL ( 'wwi vw_order_event' ), 'wwi vw_order_event'[EventTS] )
				VAR MaxDT =
				    MAXX ( ALL ( 'wwi vw_order_event' ), 'wwi vw_order_event'[EventTS] )
				VAR MinDate = DATE ( YEAR ( MinDT ), MONTH ( MinDT ), DAY ( MinDT ) )
				VAR MaxDate = DATE ( YEAR ( MaxDT ), MONTH ( MaxDT ), DAY ( MaxDT ) )
				VAR FiscalStartMonth = 4
				RETURN
				ADDCOLUMNS (
				    CALENDAR ( MinDate, MaxDate ),
				
				    "year", YEAR ( [Date] ),
				    "month_number", MONTH ( [Date] ),
				    "month", FORMAT ( [Date], "MMM" ),
				    "month_year", FORMAT ( [Date], "MMM YYYY" ),
				    "month_year_sort", YEAR ( [Date] ) * 100 + MONTH ( [Date] ),
				
				    "quarter", "Q" & FORMAT ( QUARTER ( [Date] ), "0" ),
				
				    "day", DAY ( [Date] ),
				    "day_of_week_number", WEEKDAY ( [Date], 2 ),        -- Mon=1
				    "day_of_week", FORMAT ( [Date], "ddd" ),
				    "is_weekend", IF ( WEEKDAY ( [Date], 2 ) >= 6, 1, 0 ),
				
				    "week_of_year", WEEKNUM ( [Date], 2 ),
				
				    "fiscal_year",
				        IF ( MONTH ( [Date] ) >= FiscalStartMonth, YEAR ( [Date] ) + 1, YEAR ( [Date] ) ),
				    "fiscal_period",
				        MOD ( MONTH ( [Date] ) - FiscalStartMonth + 12, 12 ) + 1,
				    "fiscal_quarter",
				        "FQ" & FORMAT ( INT ( MOD ( MONTH ( [Date] ) - FiscalStartMonth + 12, 12 ) / 3 ) + 1, "0" )
				)
				
				```

	annotation PBI_Id = 0e359a2c98024979927f9a976c97b8c4


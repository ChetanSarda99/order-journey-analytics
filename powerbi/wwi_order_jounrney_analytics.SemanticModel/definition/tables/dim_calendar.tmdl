		summarizeBy: none
		isNameInferred
		sourceColumn: [month_year_sort]

		annotation SummarizationSetBy = Automatic

	column quarter
		lineageTag: 79b8ac2a-d753-4039-8d7c-82fbe28b0eaf
		summarizeBy: none

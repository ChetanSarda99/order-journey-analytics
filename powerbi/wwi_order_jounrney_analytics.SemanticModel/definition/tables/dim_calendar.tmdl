/// Date dimension table generated from event log date range. Includes fiscal year (Apr start), weekday flags, and sort columns. Marked as Date Table.
table dim_calendar
	lineageTag: 147822b2-cb09-4433-ae8b-49279df47aab
	dataCategory: Time

	column Date
		isKey
		formatString: General Date
		lineageTag: 009d6bff-544d-4071-923d-3fc34a5a44c3
		summarizeBy: none
		isNameInferred
		sourceColumn: [Date]

		annotation SummarizationSetBy = Automatic

	column year
		formatString: 0
		lineageTag: b75716da-fd71-4422-8501-558150db037d
		summarizeBy: none
		isNameInferred
		sourceColumn: [year]

		annotation SummarizationSetBy = Automatic

	column month_number
